# 本文件由 bash 读取；复制为 .env 后配置。
# 同步配置项时保留现有 .env 的部署值；身份、凭据及功能开关按实际环境设置。
AVATAR_HOST=0.0.0.0
AVATAR_PORT=18080
# 留空时读取安装包版本；用于平台 API 和管理 ACS，个人分身 ACS 保留用户填写的版本。
AVATAR_VERSION=1.4.0
# 注册适配器：demo / acps-direct / acps-entity；管理端显示实际配置，修改后需重启。
AVATAR_PROVIDER=demo
# 正式新分身直接申请：改为 acps-direct，并配置 Registry/CA；经平台及 Registry 双审核后签证。
# 已有 DEMO 身份不会自动升级或替换；本体缺失/待审时创建任务显示等待。
AVATAR_SECURE_COOKIE=0
# AVATAR_DATA_DIR=/absolute/path/to/data
# PostgreSQL 必填。部署时设置实际 DSN，启动前完成旧 SQLite 数据的离线迁移及校验。
# 示例：DATABASE_URL='postgresql:///avatar?user=avatar_app'
DATABASE_URL=
# 本项目 Redis 使用 Unix 套接字。留空关闭缓存。
# 可用 PATH 指向原生 redis-server，也可将其放在 redis/bin/。
# export PATH="$PWD/redis/bin:$PATH"
AVATAR_REDIS_SOCKET=redis/redis.sock
# 本机 Kafka 可保持为空，配置后启用任务队列。设置 MANAGED=1 由项目启动本机容器。
AVATAR_KAFKA_BOOTSTRAP=
AVATAR_KAFKA_MANAGED=0
AVATAR_KAFKA_PORT=19092
AVATAR_KAFKA_CONTROLLER_PORT=19093
# 可选：./service.sh 启停数据库使用的 PostgreSQL 二进制根目录（默认 ~/.local/pgsql-16）；
# 数据目录固定为 data/pgsql，两者任一不存在时启停自动跳过（由外部管理 PostgreSQL）。
# AVATAR_PG_HOME=/home/you/.local/pgsql-16
# HTTPS 反向代理部署时设置 AVATAR_SECURE_COOKIE=1。

# 模型请求优先直连；建连失败时才使用此备用代理（可填写 SSH 隧道转发的本地 HTTP 代理）。
# 不自动继承 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY。
AVATAR_MODEL_PROXY=

# 本地 DNS 返回不可达地址时，可指定官方 DNS 查询确认的 CDN 别名。
# 仅改变解析域名，模型 API URL/Host/TLS 验证仍用官方域名；不写死 IP。
# CDN 分发域名可能变更；确认可达后配置，恢复本机解析时删除此项。
AVATAR_MODEL_DNS_ALIASES='{}'
# AVATAR_MODEL_DNS_ALIASES='{"api.deepseek.com":"cdn.example.org"}'

# 自定义模型支持 HTTP/HTTPS 地址，无需配置 IP 白名单，同样直连优先、代理备用。

# Keycloak 统一认证。开启后只有根管理员可使用本地密码，其他账户使用 Keycloak 用户名和密码。
# 当前提供者为公开客户端，无需 Secret；改为机密客户端后只在服务器设置 Secret。
AVATAR_OIDC_ENABLED=0
AVATAR_OIDC_ISSUER=
AVATAR_OIDC_CLIENT_ID=personal-avatar
AVATAR_PUBLIC_URL=
AVATAR_OIDC_CLIENT_SECRET=

# 管理系统 AIP：正式 AIC、已获批 ACS、client/server 双证书及可信 CA 就绪后启用。
# 证书和 ATR 状态读取 data/system_identity/registration.json，不在这里填写私钥或注册密码。
AVATAR_SYSTEM_AIP_ENABLED=0
AVATAR_SYSTEM_AIP_AIC=
AVATAR_SYSTEM_AIP_HOST=0.0.0.0
AVATAR_SYSTEM_AIP_PORT=10000
AVATAR_SYSTEM_AIP_PUBLIC_URL=

# 管理系统普通服务 ATR 自动注册；同一身份审核和签发证书后直接启动 RPC，不自动审批。
# 管理系统配置就绪后启用 ATR/AIP；正式个人分身选择 AVATAR_PROVIDER=acps-direct。
# 注册账号与 Keycloak/本地 admin 无关；敏感值仅在服务器 .env 填写并保持 0600。
AVATAR_SYSTEM_ATR_ENABLED=0
WIT_REGISTRY_USERNAME=
WIT_REGISTRY_PASSWORD=
# 自动注册时 AVATAR_SYSTEM_AIP_AIC 留空或填写管理系统自身的正式 AIC。

# 旧派生模式兼容开关；当前直接实体流程保持为 0，不需要个人本体。
AVATAR_PERSONAL_ATR_ENABLED=0

# 个人分身独占端口：IP 直连，每个稳定账户固定分配一个端口，不依赖 DNS/hosts。
# 路径固定 /aip/rpc；每份实体证书 IP SAN 必须覆盖 ACS 声明的服务器 IP。
# 正式实体经平台与 Registry 双审核、签证并校验后才实际监听。
AVATAR_ENTITY_AIP_ENABLED=0
# 每个账户固定独占端口；端口段不得覆盖 HTTP Web 或管理系统协议端口
AVATAR_ENTITY_AIP_PORT=10001
AVATAR_ENTITY_AIP_PORT_END=15000

# 小镇公开访客与直接实体完整示例：deploy/town-integration.env.example。
# 公开客户端不需要 Secret；账户迁移须核验 issuer/sub，不自动按同名合并。
AVATAR_TOWN_PUBLIC_ENABLED=0
AVATAR_TOWN_OIDC_ISSUER=
# 校验 aud 中至少一个受众；azp 另外与 AVATAR_TOWN_OIDC_CLIENT_ID 核对，不把 azp 当 aud。
AVATAR_TOWN_OIDC_AUDIENCES=
AVATAR_TOWN_OIDC_CLIENT_ID=

# 首次创建 WIT 注册配置时填写；已有身份沿用私有 registration.json。
WIT_REGISTRY_URL=
WIT_CA_URL=
WIT_REGISTRY_MTLS_URL=

# 以下第三方公开端点均可覆盖；注释项留空表示使用内置公开默认地址。
# AVATAR_OPENAI_BASE_URL=https://api.openai.com/v1
# AVATAR_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AVATAR_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AVATAR_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# AVATAR_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AVATAR_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# AVATAR_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AVATAR_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# AVATAR_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AVATAR_SILICONFLOW_CATALOG_URL=https://www.siliconflow.cn/models
# AVATAR_GITHUB_ARCHIVE_HOST=codeload.github.com
# AVATAR_ICONIFY_HOST=api.iconify.design
# AVATAR_PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v0.27.8/full

# 可选：在更换虚拟环境时复用经自检的沙箱依赖，准备脚本与服务须使用同一路径。
# AVATAR_SANDBOX_RUNTIME=.tools/sandbox/pyodide-0.27.8
