# 当前小镇接入示例；按实际域名/端口和已核验的身份绑定填写，不直接覆盖生产 .env。
AVATAR_OIDC_ENABLED=1
AVATAR_OIDC_ISSUER=https://id.example.org/realms/example
AVATAR_OIDC_CLIENT_ID=example-client
# AVATAR_OIDC_CLIENT_SECRET=<仅填写于服务器受限私有配置>
AVATAR_PUBLIC_URL=https://avatar.example.org
AVATAR_SECURE_COOKIE=1

# 公开访客入口；无 Token 按临时访客处理，显式提交的 Token 仍须严格校验。
AVATAR_TOWN_PUBLIC_ENABLED=1
AVATAR_TOWN_OIDC_ISSUER=https://id.example.org/realms/example
# 校验 aud 中至少一个受众；azp 另外与 AVATAR_TOWN_OIDC_CLIENT_ID 核对，不把 azp 当 aud。
AVATAR_TOWN_OIDC_AUDIENCES=example-town-client
AVATAR_TOWN_OIDC_CLIENT_ID=example-town-client

# 智能体 ACS 及 mTLS 地址保持 IP + 固定端口；浏览器管理域名不替代这些端点。
AVATAR_SYSTEM_AIP_PORT=10000
AVATAR_SYSTEM_AIP_PUBLIC_URL=https://avatar.example.org:10000/aip/rpc
AVATAR_ENTITY_AIP_PORT=10001
AVATAR_ENTITY_AIP_PORT_END=15000

# 个人独立实体，经平台与 Registry 双审核后签证
AVATAR_PROVIDER=acps-direct
AVATAR_PERSONAL_ATR_ENABLED=0
AVATAR_ENTITY_AIP_ENABLED=1

# 首次创建 WIT 注册配置时填写；已有身份沿用私有 registration.json。
WIT_REGISTRY_URL=
WIT_CA_URL=
WIT_REGISTRY_MTLS_URL=
